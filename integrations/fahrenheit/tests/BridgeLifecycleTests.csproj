<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup Condition="Exists('../BridgeLifecycle.cs')">
    <Compile Include="../BridgeLifecycle.cs" Link="BridgeLifecycle.cs" />
  </ItemGroup>
  <PropertyGroup Condition="Exists('../BridgeLifecycle.cs')">
    <DefineConstants>$(DefineConstants);HAS_BRIDGE_LIFECYCLE</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="Exists('../BridgeResizeScope.cs')">
    <Compile Include="../BridgeResizeScope.cs" Link="BridgeResizeScope.cs" />
  </ItemGroup>
  <PropertyGroup Condition="Exists('../BridgeResizeScope.cs')">
    <DefineConstants>$(DefineConstants);HAS_RESIZE_SCOPE</DefineConstants>
  </PropertyGroup>
</Project>
