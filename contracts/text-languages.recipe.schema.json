{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MOD-006 PT-BR authoring recipe",
  "description": "Only the closed catalogue and exact per-table bounds are accepted by pack.py. Macro row IDs are chunk*65536+row; weapon-name slots are 0..13. Preserve atomic controls and line/page allocation. API 1-3 also require source byte/width capacity; explicit API 4 permits bounded container-backed growth and reports layout review. Producer selects an exact supported executable from --exe or the source installation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "locale",
    "display_name",
    "pack_version",
    "resources"
  ],
  "properties": {
    "locale": {
      "const": "pt-BR"
    },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96
    },
    "pack_version": {
      "type": "string",
      "pattern": "^[0-9]{1,9}\\.[0-9]{1,9}\\.[0-9]{1,9}$"
    },
    "resources": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 4091,
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "row",
            "slot",
            "text"
          ],
          "properties": {
            "row": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1048575
            },
            "slot": {
              "type": "integer",
              "minimum": 0,
              "maximum": 13
            },
            "text": {
              "type": "string",
              "maxLength": 2048
            }
          }
        }
      }
    }
  }
}
