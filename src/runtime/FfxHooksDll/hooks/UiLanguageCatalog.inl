    {{u8"RESTART REQUIRED - Display and debit the same partial fee.",u8"REINICIE - Exibe e desconta o mesmo custo parcial.",u8"REINICIA - Muestra y descuenta el mismo coste parcial.",u8"RED\u00c9MARRAGE - Affiche et d\u00e9bite le m\u00eame co\u00fbt partiel.",u8"RIAVVIO - Mostra e addebita lo stesso costo parziale.",u8"NEUSTART - Zeigt und berechnet dieselben Teilkosten.",u8"\u8981\u518d\u8d77\u52d5 - \u8868\u793a\u3057\u305f\u90e8\u5206\u6d88\u8cbb\u91cf\u3068\u5b9f\u969b\u306e\u6d88\u8cbb\u3092\u4e00\u81f4\u3002",u8"\uc7ac\uc2dc\uc791 \ud544\uc694 - \ud45c\uc2dc\ud55c \ubd80\ubd84 \ube44\uc6a9\uacfc \uc2e4\uc81c \uc18c\ubaa8\ub7c9\uc744 \uc77c\uce58\uc2dc\ud0b5\ub2c8\ub2e4.",u8"\u9700\u8981\u91cd\u542f - \u663e\u793a\u7684\u90e8\u5206\u6d88\u8017\u4e0e\u5b9e\u9645\u6263\u9664\u4fdd\u6301\u4e00\u81f4\u3002"}},
    {{u8"RESTART REQUIRED - Eight stats + MP; separate from elements.",u8"REINICIE - Oito atributos e MP; separado dos elementos.",u8"REINICIA - Ocho atributos y PM; separado de los elementos.",u8"RED\u00c9MARRAGE - Huit statistiques et PM ; ind\u00e9pendant des \u00e9l\u00e9ments.",u8"RIAVVIO - Otto statistiche e MP; separato dagli elementi.",u8"NEUSTART - Acht Werte und MP; unabh\u00e4ngig von Elementen.",u8"\u8981\u518d\u8d77\u52d5 - 8\u80fd\u529b\u5024\u3068MP\u3092\u8868\u793a\u3002\u5c5e\u6027\u8a2d\u5b9a\u3068\u306f\u72ec\u7acb\u3002",u8"\uc7ac\uc2dc\uc791 \ud544\uc694 - \ub2a5\ub825\uce58 8\uac1c\uc640 MP. \uc18d\uc131\uacfc \ubcc4\ub3c4 \uc124\uc815\uc785\ub2c8\ub2e4.",u8"\u9700\u8981\u91cd\u542f - \u516b\u9879\u5c5e\u6027\u503c\u548c MP\uff1b\u4e0e\u5143\u7d20\u8bbe\u7f6e\u72ec\u7acb\u3002"}},
    {{u8"RESTART REQUIRED - Elemental potency above half Overdrive.",u8"REINICIE - Pot\u00eancia elemental acima de metade do Overdrive.",u8"REINICIA - Potencia elemental con m\u00e1s de medio Overdrive.",u8"RED\u00c9MARRAGE - Puissance \u00e9l\u00e9mentaire au-del\u00e0 de la moiti\u00e9 d'Overdrive.",u8"RIAVVIO - Potenza elementale sopra met\u00e0 Overdrive.",u8"NEUSTART - Elementarst\u00e4rke bei mehr als halbem Overdrive.",u8"\u8981\u518d\u8d77\u52d5 - OD\u30b2\u30fc\u30b8\u304c\u534a\u5206\u3092\u8d85\u3048\u308b\u3068\u5c5e\u6027\u5a01\u529b\u4e0a\u6607\u3002",u8"\uc7ac\uc2dc\uc791 \ud544\uc694 - \uc624\ubc84\ub4dc\ub77c\uc774\ube0c\uac00 \uc808\ubc18\uc744 \ub118\uc73c\uba74 \uc18d\uc131 \uc704\ub825\uc774 \uc0c1\uc2b9\ud569\ub2c8\ub2e4.",u8"\u9700\u8981\u91cd\u542f - \u8d85\u9650\u6280\u69fd\u8d85\u8fc7\u4e00\u534a\u65f6\u63d0\u5347\u5143\u7d20\u5a01\u529b\u3002"}},
