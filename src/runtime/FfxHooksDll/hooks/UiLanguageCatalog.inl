    {{u8"RESTART REQUIRED - Bonuses follow the formula's actual stats.",u8"REINICIE - B\u00f4nus seguem os atributos usados pela f\u00f3rmula.",u8"REINICIA - Los bonos siguen los atributos usados por la f\u00f3rmula.",u8"RED\u00c9MARRAGE - Les bonus suivent les statistiques de la formule.",u8"RIAVVIO - I bonus seguono gli attributi usati dalla formula.",u8"NEUSTART - Boni folgen den tats\u00e4chlichen Werten der Formel.",u8"\u8981\u518d\u8d77\u52d5 - \u30dc\u30fc\u30ca\u30b9\u306f\u8a08\u7b97\u5f0f\u304c\u4f7f\u3046\u80fd\u529b\u5024\u306b\u9069\u7528\u3002",u8"\uc7ac\uc2dc\uc791 \ud544\uc694 - \ubcf4\ub108\uc2a4\ub294 \uacf5\uc2dd\uc5d0 \uc0ac\uc6a9\ub418\ub294 \uc2e4\uc81c \ub2a5\ub825\uce58\ub97c \ub530\ub985\ub2c8\ub2e4.",u8"\u9700\u8981\u91cd\u542f - \u52a0\u6210\u6309\u516c\u5f0f\u5b9e\u9645\u4f7f\u7528\u7684\u5c5e\u6027\u8ba1\u7b97\u3002"}},
    {{u8"RESTART REQUIRED - Boss max HP /16; immunity; nonlethal.",u8"REINICIE - HP m\u00e1ximo do chefe /16; respeita imunidade; n\u00e3o letal.",u8"REINICIA - HP m\u00e1ximos del jefe /16; respeta inmunidad; no letal.",u8"RED\u00c9MARRAGE - PV max du boss /16 ; immunit\u00e9 respect\u00e9e ; non l\u00e9tal.",u8"RIAVVIO - HP massimi del boss /16; rispetta immunit\u00e0; non letale.",u8"NEUSTART - Max. Boss-HP /16; Immunit\u00e4t beachten; nicht t\u00f6dlich.",u8"\u8981\u518d\u8d77\u52d5 - \u30dc\u30b9\u6700\u5927HP\u306e1/16\u3002\u7121\u52b9\u8010\u6027\u3092\u5c0a\u91cd\u3057\u3001\u81f4\u6b7b\u306b\u306f\u3057\u307e\u305b\u3093\u3002",u8"\uc7ac\uc2dc\uc791 \ud544\uc694 - \ubcf4\uc2a4 \ucd5c\ub300 HP /16. \uba74\uc5ed \uc801\uc6a9, \uce58\uba85\uc801 \ud53c\ud574 \uc5c6\uc74c.",u8"\u9700\u8981\u91cd\u542f - \u9996\u9886\u6700\u5927 HP \u7684 1/16\uff1b\u9075\u5b88\u514d\u75ab\uff1b\u4e0d\u4f1a\u81f4\u6b7b\u3002"}},
